# Studio OS Phase 1 local runtime only. Do not reuse these credentials in production.
DEBUG=0
SECRET_KEY=studio-phase-1-local-secret-change-before-any-shared-deployment
ALLOWED_HOSTS=127.0.0.1,localhost,api
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3200,http://localhost:3200,http://127.0.0.1:3201,http://localhost:3201

POSTGRES_USER=studio_plane
POSTGRES_PASSWORD=studio_plane_local
POSTGRES_HOST=plane-db
POSTGRES_DB=studio_plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://studio_plane:studio_plane_local@plane-db:5432/studio_plane

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=studio_plane
RABBITMQ_PASSWORD=studio_plane_local
RABBITMQ_VHOST=studio_plane

AWS_REGION=
AWS_ACCESS_KEY_ID=studio-local-access-key
AWS_SECRET_ACCESS_KEY=studio-local-secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=studio-uploads
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600
USE_MINIO=1
MINIO_ENDPOINT_SSL=0

WEB_URL=http://127.0.0.1:8200
APP_BASE_URL=http://127.0.0.1:3200
APP_BASE_PATH=
ADMIN_BASE_URL=http://127.0.0.1:3201
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=http://127.0.0.1:3202
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=http://127.0.0.1:3300
LIVE_BASE_PATH=/live
LIVE_SERVER_SECRET_KEY=studio-phase-1-local-live-secret

GUNICORN_WORKERS=2
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT=60/minute
DOCKERIZED=1

# Keep all analytics/telemetry local during Phase 0/1 verification.
POSTHOG_API_KEY=
POSTHOG_HOST=
OTLP_ENDPOINT=http://127.0.0.1:9
